{
  "name": "tactical-football",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/core && tsc -p packages/data && tsc -p packages/i18n && tsc -p tools/gen && tsc -p tools/import && tsc -p tools/sim",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen": "tsx tools/gen/src/cli.ts",
    "import:football-data": "tsx tools/import/src/footballData.ts",
    "sim": "tsx tools/sim/src/cli.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tf/core": "*",
    "@tf/data": "*",
    "@tf/i18n": "*"
  }
}
